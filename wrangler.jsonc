{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "gopal-singh-portfolio",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-25",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "ai": {
    "binding": "AI"
  }
}
